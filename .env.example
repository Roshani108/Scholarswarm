# ScholarSwarm Environment Configuration Example
# All keys are optional. When keys are not supplied, ScholarSwarm automatically
# uses DuckDuckGo for search, GitHub public unauthenticated REST API,
# and high-precision heuristic reasoning + offline mock replay if LLM key is absent.

# Google Gemini API Key (Free tier friendly: gemini-2.0-flash / gemini-1.5-flash)
# Get one at https://aistudio.google.com/
GEMINI_API_KEY=

# Tavily AI Search API Key (optional, fallbacks to DuckDuckGo if empty)
# Get one at https://tavily.com/
TAVILY_API_KEY=

# GitHub Personal Access Token (optional, raises rate limits from 60 to 5000 req/hr)
GITHUB_TOKEN=

# Alternative LLM Providers (if you prefer OpenAI or Groq)
OPENAI_API_KEY=
GROQ_API_KEY=
PRIMARY_LLM_PROVIDER=gemini
PRIMARY_LLM_MODEL=gemini-2.0-flash

# System Tuning
MIN_VERIFIED_OPPORTUNITIES=10
CANDIDATES_HARVEST_TARGET=15
ENABLE_CACHE=true
